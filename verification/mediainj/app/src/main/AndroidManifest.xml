<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <application android:label="MediaInj" android:theme="@style/Theme.AppCompat.Light">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <receiver android:name=".ActReceiver" android:exported="false"/>
    <receiver android:name=".CmdReceiver" android:exported="true">
      <intent-filter>
        <action android:name="com.test.mediainj.CMD"/>
      </intent-filter>
    </receiver>
  </application>
</manifest>
